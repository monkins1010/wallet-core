{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2020",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "strictNullChecks": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": false
  },
  "include": [
    "src/**/*",
    "modules/**/*"
  ],
  "exclude": ["node_modules", "**/__tests__/*", "**/*.test.ts", "**/*.spec.ts", "modules/evm-contracts/**/*", "modules/error-parser/test/**/*"]
}